#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} harus berupa jalur impor atau kamus yang berisi jalur impor "
"BACKEND dan kamus OPTIONS opsional."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "Tidak dapat mengimpor layanan terjemahan {service} ({source})."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Tidak dapat mengimpor layanan terjemahan {service}."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"Layanan penerjemahan {service} ({source}) bukanlah subkelas dari {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "Layanan penerjemahan {service} bukan merupakan subkelas dari {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Opsi tidak valid untuk layanan terjemahan {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Menerjemahkan file pesan (.po) yang dibuat oleh {makemessages} menggunakan "
"mesin. Hanya pesan baru dan yang diubah yang diterjemahkan. Menerjemahkan "
"direktori lokal yang diberikan dengan {path} dan {app}, atau yang ada di "
"{locale_paths} jika keduanya tidak diberikan."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Direktori lokal yang akan diterjemahkan (dapat diberikan lebih dari satu "
"kali)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Aplikasi yang pesan-pesannya perlu diterjemahkan (dapat diberikan lebih dari "
"sekali)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Terjemahkan hanya locale ini, misalnya pt_BR atau pt-br (dapat diberikan "
"lebih dari sekali). Secara default, setiap locale yang ditemukan akan "
"diterjemahkan."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Terjemahkan kembali semua pesan, termasuk pesan yang sudah diterjemahkan dan "
"pesan yang masih menunggu peninjauan."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Tandai terjemahan mesin sebagai \"fuzzy\" agar dapat ditinjau sebelum "
"digunakan (entri \"fuzzy\" tidak dikompilasi secara default)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "Bahasa yang digunakan dalam pesan tersebut."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "Layanan terjemahan yang akan digunakan sebagai pengganti {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Tampilkan bilah kemajuan (membutuhkan paket tqdm). Secara default, bilah "
"kemajuan akan ditampilkan jika tqdm sudah terpasang dan outputnya berupa "
"terminal."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "Terjemahan dinonaktifkan. Atur {setting} di pengaturan Anda."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} memerlukan paket {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Tidak ada direktori lokal yang perlu diterjemahkan. Gunakan {path} atau "
"{app}, atau atur {setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Total"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "pesan"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "Direktori lokal {directory} tidak ada."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "Melewati {locale}: tidak dipilih dengan {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Melewati {file}: {service} tidak mendukung {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Menerjemahkan {file} ke dalam {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} mengembalikan jumlah terjemahan yang salah: yang diharapkan "
"{sent}, yang diterima {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Terjemahan dari {source} dibuang karena placeholder atau markup-nya berubah: "
"{translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Subkelas dari {base} harus mengimplementasikan {function}()."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} memerlukan opsi {option} . Tambahkan opsi tersebut ke OPTIONS di "
"{setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr "{service} membutuhkan paket {package} . Instal dengan: {command}"
