#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} deve essere un percorso di importazione o un dizionario con un "
"percorso di importazione BACKEND e un dizionario OPTIONS facoltativo."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "Impossibile importare il servizio di traduzione {service} ({source})."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Impossibile importare il servizio di traduzione {service}."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"Il servizio di traduzione {service} ({source}) non è una sottoclasse di "
"{base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "Il servizio di traduzione {service} non è una sottoclasse di {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Opzioni non valide per il servizio di traduzione {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Traduce automaticamente i file di messaggio (.po) creati da {makemessages}. "
"Vengono tradotti solo i messaggi nuovi e modificati. Traduce le directory "
"delle impostazioni locali specificate con {path} e {app}, oppure quelle in "
"{locale_paths} se non ne viene specificato nessuno dei due."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Una directory locale da tradurre (può essere specificata più di una volta)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Un'app i cui messaggi devono essere tradotti (può essere richiesto più di "
"una volta)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Traduci solo questa lingua, ad esempio pt_BR o pt-br (può essere specificata "
"più di una volta). Per impostazione predefinita, tutte le lingue trovate "
"vengono tradotte."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Traduci nuovamente tutti i messaggi, inclusi quelli già tradotti e quelli in "
"attesa di revisione."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Contrassegna le traduzioni automatiche come approssimative in modo che "
"possano essere revisionate prima dell'uso (le voci approssimative non "
"vengono compilate per impostazione predefinita)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "La lingua in cui sono scritti i messaggi."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "Il servizio di traduzione da utilizzare al posto di {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Mostra una barra di avanzamento (richiede il pacchetto tqdm). Per "
"impostazione predefinita, viene visualizzata se tqdm è installato e l'output "
"è un terminale."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr ""
"La traduzione è disabilitata. Imposta {setting} nelle tue impostazioni."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} richiede il pacchetto {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Nessuna directory locale da tradurre. Utilizzare {path} o {app} oppure "
"impostare {setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Totale"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "messaggi"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "La directory delle impostazioni locali {directory} non esiste."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "Saltando {locale}: non selezionato con {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Saltando {file}: {service} non supporta {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Traduzione del file {file} nella {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} ha restituito un numero errato di traduzioni: previsto {sent}, "
"ricevuto {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"La traduzione di {source} è stata scartata perché i suoi segnaposto o il "
"markup sono cambiati: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Le sottoclassi di {base} devono implementare {function}()."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} richiede l'opzione {option} . Aggiungila a OPTIONS in {setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr "{service} richiede il pacchetto {package} . Installalo con: {command}"
