#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} paraméternek importálási útvonalnak vagy egy HÁTTÉR importálási "
"útvonallal és egy opcionális OPTIONS szótárral rendelkező szótárnak kell "
"lennie."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "A {service} ({source}) fordítási szolgáltatás importálása sikertelen."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "A( {service} fordítási szolgáltatás importálása sikertelen."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr "A {service} ({source}) fordítási szolgáltatás nem a {base} alosztálya."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "A {service} fordítási szolgáltatás nem a {base} alosztálya."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Érvénytelen beállítások {service} fordítási szolgáltatáshoz: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Gépi fordítás {makemessages} által létrehozott üzenetfájlokról (.po). Csak "
"az új és módosított üzenetek kerülnek fordításra. Lefordítja a {path} és "
"{app} paraméterekkel megadott területi könyvtárakat, vagy ha egyik sincs "
"megadva, {locale_paths} paraméterben találhatóakat."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr "Egy lefordítandó területi könyvtár (többször is megadható)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Egy alkalmazás, amelynek üzeneteit le kell fordítani (többször is megadható)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Csak ezt a területi beállítást fordítsa le, pl. pt_BR vagy pt-br (többször "
"is megadható). Alapértelmezés szerint minden talált területi beállítás le "
"van fordítva."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Fordítsd le újra az összes üzenetet, beleértve a lefordított üzeneteket és "
"az ellenőrzésre váró üzeneteket is."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Jelöld meg a gépi fordításokat homályosként, hogy használat előtt "
"ellenőrizni lehessen őket (a homályos bejegyzések alapértelmezés szerint nem "
"fordítódnak le)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "A nyelv, amelyen az üzenetek íródtak."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "{setting} helyett használandó fordítási szolgáltatás."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Folyamatjelző megjelenítése (a tqdm csomag szükséges hozzá). Alapértelmezés "
"szerint akkor látható, ha a tqdm telepítve van, és a kimenet egy terminál."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr ""
"A fordítás le van tiltva. Állítsa be a {setting} értéket a beállításokban."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} opcióhoz a(z) {package} csomag szükséges."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Nincsenek lefordítandó területi könyvtárak. Használja {path} vagy {app} "
"paramétert, vagy állítsa be {setting} értéket."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Teljes"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "üzenetek"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "A {directory} területi beállításkönyvtár nem létezik."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "{locale} kihagyása: nincs kiválasztva a {option} opcióval."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "{file} kihagyása : {service} nem támogatja {language} nyelvet."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "{file} fordítása {target_language} nyelvre"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} hibás számú fordítást adott vissza: a várt {sent}, a kapott "
"{received} volt."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"A {source} fordítását elvetettem, mert a helyőrzői vagy a jelölése "
"megváltozott: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "{base} alosztályainak implementálniuk kell {function}() függvényt."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"A {service} szükséges a {option} opció. Adja hozzá az OPTIONS beállításokhoz "
"{setting} beállításban."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr ""
"{service} a {package} csomag szükséges. Telepítse a következő parancs "
"segítségével: {command}"
