#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} muss ein Importpfad oder ein Wörterbuch mit einem BACKEND-"
"Importpfad und einem optionalen OPTIONS-Wörterbuch sein."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr ""
"Der Übersetzungsdienst {service} ({source}) konnte nicht importiert werden."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Der Übersetzungsdienst {service} konnte nicht importiert werden."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"Der Übersetzungsdienst {service} ({source}) ist keine Unterklasse von {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "Der Übersetzungsdienst {service} ist keine Unterklasse von {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Ungültige Optionen für den Übersetzungsdienst {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Maschinelle Übersetzung der von {makemessages} erstellten Nachrichtendateien "
"(.po). Nur neue und geänderte Nachrichten werden übersetzt. Übersetzt werden "
"die mit {path} und {app} angegebenen Gebietsschemaverzeichnisse oder, falls "
"keines von beiden angegeben ist, die in {locale_paths} ."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Ein Verzeichnis der zu übersetzenden Sprachen (kann auch mehrmals angegeben "
"werden)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Eine App, deren zu übersetzende Nachrichten (mehrfach angegeben werden "
"können)"

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Nur diese Gebietsschema-Einstellung wird übersetzt, z. B. pt_BR oder pt-br "
"(kann mehrfach angegeben werden). Standardmäßig wird jedes gefundene "
"Gebietsschema übersetzt."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Übersetzen Sie alle Nachrichten erneut, einschließlich der bereits "
"übersetzten Nachrichten und der Nachrichten, die noch auf die Überprüfung "
"warten."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Maschinelle Übersetzungen sollten als unscharf gekennzeichnet werden, damit "
"sie vor der Verwendung überprüft werden können (unscharfe Einträge werden "
"standardmäßig nicht kompiliert)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "Die Sprache, in der die Nachrichten verfasst sind."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr ""
"Der Übersetzungsdienst, der anstelle von {setting} verwendet werden soll."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Zeigt einen Fortschrittsbalken an (erfordert das tqdm-Paket). Dieser wird "
"standardmäßig angezeigt, wenn tqdm installiert ist und die Ausgabe im "
"Terminal erfolgt."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr ""
"Die Übersetzung ist deaktiviert. Aktivieren Sie {setting} in Ihren "
"Einstellungen."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} erfordert das Paket {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Es sind keine Gebietsschemaverzeichnisse zum Übersetzen vorhanden. Verwenden "
"Sie {path} oder {app}, oder legen Sie {setting} fest."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Gesamt"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "Nachrichten"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "Das Gebietsschemaverzeichnis {directory} existiert nicht."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "{locale} wird übersprungen: nicht mit {option} ausgewählt."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Überspringen von {file}: {service} unterstützt {language} nicht ."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Übersetzung von {file} in {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} hat die falsche Anzahl an Übersetzungen zurückgegeben: erwartet "
"{sent}, erhalten {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Die Übersetzung von {source} wurde verworfen, da sich die Platzhalter oder "
"die Auszeichnung geändert haben: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Unterklassen von {base} müssen {function}() implementieren."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} benötigt die Option {option} . Fügen Sie sie in {setting} zu "
"OPTIONS hinzu."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr ""
"{service} benötigt das Paket {package} . Installieren Sie es mit: {command}"
