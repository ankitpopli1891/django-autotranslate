#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} debe ser una ruta de importación o un diccionario con una ruta de "
"importación BACKEND y un diccionario OPTIONS opcional."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "No se pudo importar el servicio de traducción {service} ({source})."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "No se pudo importar el servicio de traducción {service}."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"El servicio de traducción {service} ({source}) no es una subclase de {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "El servicio de traducción {service} no es una subclase de {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Opciones no válidas para el servicio de traducción {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Traduce automáticamente los archivos de mensajes (.po) creados por "
"{makemessages}. Solo se traducen los mensajes nuevos y los modificados. "
"Traduce los directorios de configuración regional especificados con {path} y "
"{app}, o los de {locale_paths} si no se especifica ninguno."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Directorio de configuración regional para traducir (puede especificarse más "
"de una vez)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Una aplicación cuyos mensajes para traducir (se pueden dar más de una vez)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Traduzca únicamente esta configuración regional, por ejemplo, pt_BR o pt-br "
"(puede especificarse más de una vez). Por defecto, se traducen todas las "
"configuraciones regionales encontradas."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Traduzca de nuevo todos los mensajes, incluidos los mensajes traducidos y "
"los mensajes pendientes de revisión."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Marque las traducciones automáticas como aproximadas para que puedan "
"revisarse antes de su uso (las entradas aproximadas no se compilan por "
"defecto)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "El idioma en el que están escritos los mensajes."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "El servicio de traducción que se utilizará en lugar de {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Muestra una barra de progreso (requiere el paquete tqdm). Por defecto, se "
"muestra si tqdm está instalado y la salida es una terminal."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "La traducción está desactivada. Configure {setting} en sus ajustes."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} requiere el paquete {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"No hay directorios de localización para traducir. Use {path} o {app}, o "
"configure {setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Total"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "mensajes"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "El directorio de configuración regional {directory} no existe."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "Omitiendo {locale}: no seleccionado con {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Omitiendo {file}: {service} no admite {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Traduciendo {file} al {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} devolvió un número incorrecto de traducciones: se esperaban "
"{sent}, se recibieron {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Se descartó la traducción de {source} porque sus marcadores de posición o "
"marcado cambiaron: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Las subclases de {base} deben implementar {function}()."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} requiere la opción {option} . Agréguela a OPTIONS en {setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr "{service} requiere el paquete {package} . Instálelo con: {command}"
