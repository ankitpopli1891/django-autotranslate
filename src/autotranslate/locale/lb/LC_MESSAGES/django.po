#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} muss en Importpad oder en Dictionnaire mat engem BACKEND-Importpad "
"an engem optionalen OPTIONS-Dictionnaire sinn."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr ""
"Den Iwwersetzungsservice {service} ({source}) konnt net importéiert ginn."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Den Iwwersetzungsservice {service} konnt net importéiert ginn."

#: config.py:87
