#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} duhet të jetë një shteg importimi ose një fjalor me një shteg "
"importimi BACKEND dhe një fjalor opsional OPTIONS."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "Nuk mundi të importojë shërbimin e përkthimit {service} ({source})."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Nuk mundi të importojë shërbimin e përkthimit {service}."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"Shërbimi i përkthimit {service} ({source}) nuk është një nënklasë e {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "Shërbimi i përkthimit {service} nuk është një nënklasë e {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Opsione të pavlefshme për shërbimin e përkthimit {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Përkthen automatikisht skedarët e mesazheve (.po) të krijuar nga "
"{makemessages}. Përkthehen vetëm mesazhet e reja dhe të ndryshuara. Përkthen "
"drejtoritë lokale të dhëna me {path} dhe {app}, ose ato në {locale_paths} "
"nëse asnjëra nuk është dhënë."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Një direktori lokale për t'u përkthyer (mund të jepet më shumë se një herë)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Një aplikacion, mesazhet e të cilit për t'u përkthyer (mund të jepen më "
"shumë se një herë)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Përkthejeni vetëm këtë vendndodhje, p.sh. pt_BR ose pt-br (mund të jepet më "
"shumë se një herë). Si parazgjedhje, çdo vendndodhje e gjetur përkthehet."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Përkthejini përsëri të gjitha mesazhet, duke përfshirë mesazhet e përkthyera "
"dhe mesazhet që presin shqyrtim."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Shënoni përkthimet automatike si të paqarta në mënyrë që të mund të "
"rishikohen para përdorimit (hyrjet e paqarta nuk kompilohen si parazgjedhje)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "Gjuha në të cilën janë shkruar mesazhet."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "Shërbimi i përkthimit që do të përdoret në vend të {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Shfaq një shirit progresi (kërkon paketën tqdm). Si parazgjedhje, shfaqet "
"nëse tqdm është instaluar dhe rezultati është një terminal."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "Përkthimi është çaktivizuar. Vendos {setting} në cilësimet e tua."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} kërkon paketën {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Nuk ka drejtori lokale për t'u përkthyer. Përdorni {path} ose {app}, ose "
"vendosni {setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Totali"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "mesazhe"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "Drejtoria e vendndodhjes {directory} nuk ekziston."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "Duke anashkaluar {locale}: nuk është zgjedhur me {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Duke anashkaluar {file}: {service} nuk e mbështet {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Duke përkthyer {file} në {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} ktheu numrin e gabuar të përkthimeve: expected {sent}, received "
"{received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Përkthimi i {source} u hodh poshtë sepse mbajtësit e vendeve ose shënimet e "
"tij ndryshuan: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Nënklasat e {base} duhet të implementojnë {function}()."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} kërkon opsionin {option} . Shtojeni atë te OPTIONS në {setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr "{service} kërkon paketën {package} . Instalojeni atë me: {command}"
