#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} bir içe aktarma yolu veya bir BACKEND içe aktarma yolu ve isteğe "
"bağlı bir OPTIONS sözlüğü içeren bir sözlük olmalıdır."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "Çeviri hizmeti {service} ({source}) içe aktarılamadı."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Çeviri servisi {service} içe aktarılamadı."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"Çeviri hizmeti {service} ({source}) {base} sınıfının bir alt sınıfı değildir."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "Çeviri hizmeti {service} {base} sınıfının bir alt sınıfı değildir."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Çeviri hizmeti {service} için geçersiz seçenekler: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"{makemessages} tarafından oluşturulan mesaj (.po) dosyalarını makine "
"çevirisine tabi tutar. Yalnızca yeni ve değiştirilmiş mesajlar çevrilir. "
"{path} ve {app} ile verilen yerel ayar dizinlerini veya bunlardan hiçbiri "
"verilmemişse {locale_paths} içindeki dizinleri çevirir."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr "Çevrilecek yerel ayar dizini (birden fazla kez verilebilir)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Mesajlarını çevirmek için kullanılan bir uygulama (çeviri işlemi birden "
"fazla kez verilebilir)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Yalnızca bu yerel ayarı çevirin, örneğin pt_BR veya pt-br (birden fazla kez "
"verilebilir). Varsayılan olarak, bulunan her yerel ayar çevrilir."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Çevrilmiş mesajlar ve incelemeyi bekleyen mesajlar da dahil olmak üzere tüm "
"mesajları tekrar çevirin."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Makine çevirilerini bulanık olarak işaretleyin, böylece kullanımdan önce "
"incelenebilirler (bulanık girdiler varsayılan olarak derlenmez)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "Mesajların yazıldığı dil."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "{setting} yerine kullanılacak çeviri hizmeti."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"İlerleme çubuğunu göster (tqdm paketini gerektirir). Varsayılan olarak, tqdm "
"yüklüyse ve çıktı bir terminal ise gösterilir."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr ""
"Çeviri devre dışı bırakıldı. Ayarlarınızda {setting} seçeneğini belirleyin."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} seçeneği {package} paketini gerektirir."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Çevrilecek yerel ayar dizini yok. {path} veya {app} kullanın ya da {setting} "
"ayarını yapın."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Toplam"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "mesajlar"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "{directory} yerel ayar dizini mevcut değil."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "{locale} atlanıyor: {option} ile seçilmedi."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "{file} atlanıyor: {service} {language} desteklemiyor."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "{file} dosyasını {target_language} diline çevirmek"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} yanlış sayıda çeviri döndürdü: beklenen {sent}, alınan {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Yer tutucuları veya işaretlemeleri değiştiği için {source} çevirisi atıldı: "
"{translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr ""
"{base} sınıfının alt sınıfları {function}() fonksiyonunu uygulamalıdır."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} hizmeti {option} seçeneğini gerektirir. Bunu {setting} içindeki "
"OPTIONS bölümüne ekleyin."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr ""
"{service} hizmeti {package} paketini gerektirir. Şu komutla yükleyin: "
"{command}"
