#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} ئىمپورت يولى ياكى ئارقا ئۇچى ئىمپورت يولى ۋە قوشۇمچە OPTIONS "
"لۇغىتى بولغان لۇغەت بولۇشى كېرەك."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "تەرجىمە مۇلازىمىتى {service} ({source}) نى ئىمپورت قىلالمىدى."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "تەرجىمە مۇلازىمىتى {service} نى ئىمپورت قىلالمىدى."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"تەرجىمە مۇلازىمىتى {service} ({source}) {base} نىڭ تارماق سىنىپى ئەمەس."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "تەرجىمە مۇلازىمىتى {service} {base} نىڭ تارماق سىنىپى ئەمەس."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "تەرجىمە مۇلازىمىتى {service} ئۈچۈن خاتا تاللاشلار: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"ماشىنا ئارقىلىق {makemessages} تەرىپىدىن ياسالغان ئۇچۇر (.po) ھۆججەتلىرىنى "
"تەرجىمە قىلىدۇ. پەقەت يېڭى ۋە ئۆزگەرتىلگەن ئۇچۇرلارلا تەرجىمە قىلىنىدۇ. "
"{path} ۋە {app} بىلەن بېرىلگەن يەرلىك ئادرېس مۇندەرىجىلىرىنى، ئەگەر "
"ھېچقايسىسى بېرىلمىگەن بولسا {locale_paths} دىكىلىرىنى تەرجىمە قىلىدۇ."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"تەرجىمە قىلىنىدىغان يەرلىك ئادرېس مۇندەرىجىسى (بىردىن ئارتۇق قېتىم بېرىلسە "
"بولىدۇ)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"تەرجىمە قىلىنىدىغان ئۇچۇرلارنى تەرجىمە قىلىدىغان ئەپ (بىردىن ئارتۇق قېتىم "
"بېرىشكە بولىدۇ)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"پەقەت مۇشۇ يەرلىك كودنى تەرجىمە قىلىڭ، مەسىلەن pt_BR ياكى pt-br (بىردىن "
"ئارتۇق بېرىلسە بولىدۇ). سۈكۈتتىكى ھالەتتە تېپىلغان ھەر بىر يەرلىك كود "
"تەرجىمە قىلىنىدۇ."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"تەرجىمە قىلىنغان ئۇچۇرلار ۋە تەكشۈرۈشنى كۈتۈۋاتقان ئۇچۇرلار قاتارلىق بارلىق "
"ئۇچۇرلارنى قايتا تەرجىمە قىلىڭ."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"ماشىنا تەرجىمىلىرىنى ئىشلىتىشتىن بۇرۇن كۆرۈپ چىقىش ئۈچۈن، ئۇلارنى تۇراقسىز "
"دەپ بەلگىلەڭ (تۇرۇقسىز خاتىرىلەر ئۆزلۈكىدىن تۈزۈلمەيدۇ)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "ئۇچۇرلارنىڭ يېزىلىش تىلى."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "{setting} نىڭ ئورنىغا ئىشلىتىلىدىغان تەرجىمە مۇلازىمىتى."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"ئىلگىرىلەش بالدىقىنى كۆرسىتىدۇ (tqdm پاكېتىنى تەلەپ قىلىدۇ). ئەگەر tqdm "
"ئورنىتىلغان بولسا ۋە چىقىرىش نەتىجىسى تېرمىنال بولسا، سۈكۈتتىكى ھالەتتە "
"كۆرسىتىلىدۇ."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "تەرجىمە چەكلەنگەن. تەڭشەكلىرىڭىزدىن {setting} تەڭشەڭ."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} ئۈچۈن {package} پاكېتىسى تەلەپ قىلىنىدۇ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"تەرجىمە قىلىدىغان يەرلىك مۇندەرىجىلەر يوق. {path} ياكى {app} نى ئىشلىتىڭ، "
"ياكى {setting} نى تەڭشەڭ."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "جەمئىي"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "ئۇچۇرلار"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "{directory} يەرلىك مۇندەرىجىسى مەۋجۇت ئەمەس."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "{locale} نى ئاتلاپ ئۆتۈش: {option} بىلەن تاللانمىغان."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "{file} نى ئاتلاپ ئۆتۈۋاتىدۇ: {service} {language} نى قوللىمايدۇ."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "{file} نى {target_language} غا تەرجىمە قىلىۋاتىدۇ"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} خاتا تەرجىمە سانىنى قايتۇردى: كۈتۈلگەن {sent}، قوبۇل قىلىنغان "
"{received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"{source} نىڭ تەرجىمىسىنىڭ ئورنىنى ئالىدىغانلار ياكى بەلگىلىرى ئۆزگەرگەچكە، "
"ئۇنىڭ تەرجىمىسى رەت قىلىندى: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "{base} نىڭ تارماق سىنىپلىرى {function}() نى ئىجرا قىلىشى كېرەك."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} ئۈچۈن {option} تاللانمىسى تەلەپ قىلىنىدۇ. ئۇنى {setting} دىكى "
"OPTIONS غا قوشۇڭ."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr ""
"{service} ئۈچۈن {package} پاكېتىسى لازىم. ئۇنى تۆۋەندىكى ئۇسۇل ئارقىلىق "
"ئورنىتىڭ: {command}"
