#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"Ní mór {setting} a bheith ina chonair allmhairithe nó ina fhoclóir le cosán "
"allmhairithe BACKEND agus foclóir OPTIONS roghnach."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr ""
"Níorbh fhéidir an tseirbhís aistriúcháin {service} ({source}) a allmhairiú."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Níorbh fhéidir an tseirbhís aistriúcháin {service} a allmhairiú."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"Ní fo-aicme de {base} í an tseirbhís aistriúcháin {service} ({source})."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "Ní fo-aicme de {base} í an tseirbhís aistriúcháin {service} ."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Roghanna neamhbhailí don tseirbhís aistriúcháin {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Aistríonn sé na comhaid teachtaireachta (.po) a chruthaigh {makemessages} le "
"meaisín. Ní aistrítear ach teachtaireachtaí nua agus athraithe. Aistríonn sé "
"na heolairí logánta a thugtar le {path} agus {app}, nó iad siúd i "
"{locale_paths} mura dtugtar ceachtar acu."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Eolaire logáin le haistriú (is féidir é seo a thabhairt níos mó ná uair "
"amháin)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Aip a bhfuil a teachtaireachtaí le haistriú (is féidir iad a thabhairt níos "
"mó ná uair amháin)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Ná haistrigh ach an logán seo, m.sh. pt_BR nó pt-br (is féidir é seo a "
"thabhairt níos mó ná uair amháin). De réir réamhshocraithe, aistrítear gach "
"logán a aimsítear."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Aistrigh gach teachtaireacht arís, lena n-áirítear teachtaireachtaí "
"aistrithe agus teachtaireachtaí atá ag fanacht le hathbhreithniú."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Marcáil aistriúcháin meaisín mar doiléir ionas gur féidir iad a "
"athbhreithniú roimh úsáid (ní dhéantar iontrálacha doiléire a thiomsú de "
"réir réamhshocraithe)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "An teanga ina scríobhtar na teachtaireachtaí."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "An tseirbhís aistriúcháin le húsáid in ionad {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Taispeáin barra dul chun cinn (éilíonn sé an pacáiste tqdm). De réir "
"réamhshocraithe, taispeántar é má tá tqdm suiteáilte agus más críochfort an "
"t-aschur."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "Tá an t-aistriúchán díchumasaithe. Socraigh {setting} i do shocruithe."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "Éilíonn {option} an pacáiste {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Níl aon eolairí logánta le haistriú. Úsáid {path} nó {app}, nó socraigh "
"{setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Iomlán"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "teachtaireachtaí"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "Níl an t-eolaire logánta {directory} ann."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "Ag scipeáil {locale}: níor roghnaíodh le {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Ag scipeáil {file}: ní thacaíonn {service} le {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Ag aistriú {file} go {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"D’fhill {service} an líon mícheart aistriúchán: bhí súil le {sent}, faighte "
"{received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Caitheadh an t-aistriúchán ar {source} mar gheall ar athrú ar a "
"áitchoinneálaithe nó a mharcáil: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Caithfidh fo-aicmí de {base} {function}() a chur i bhfeidhm."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr "Éilíonn {service} an rogha {option} . Cuir le ROGHANNA i {setting} é."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr "Éilíonn {service} an pacáiste {package} . Suiteáil é le: {command}"
