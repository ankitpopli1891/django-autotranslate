#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} mestilah laluan import atau kamus dengan laluan import BACKEND dan "
"kamus OPTIONS pilihan."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "Tidak dapat mengimport perkhidmatan terjemahan {service} ({source})."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Tidak dapat mengimport perkhidmatan terjemahan {service}."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"Perkhidmatan terjemahan {service} ({source}) bukanlah subkelas bagi {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "Perkhidmatan terjemahan {service} bukanlah subkelas bagi {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Pilihan tidak sah untuk perkhidmatan terjemahan {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Terjemahkan fail mesej (.po) yang dicipta oleh {makemessages} dengan mesin. "
"Hanya mesej baharu dan mesej yang diubah akan diterjemahkan. Menterjemahkan "
"direktori locale yang diberikan dengan {path} dan {app}, atau direktori "
"dalam {locale_paths} jika kedua-duanya tidak diberikan."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Direktori lokasi untuk diterjemahkan (boleh diberikan lebih daripada sekali)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Aplikasi yang mesejnya perlu diterjemahkan (boleh diberikan lebih daripada "
"sekali)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Hanya terjemahkan lokasi ini, contohnya pt_BR atau pt-br (boleh diberikan "
"lebih daripada sekali). Secara lalai setiap lokasi yang ditemui "
"diterjemahkan."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Terjemahkan semua mesej sekali lagi, termasuk mesej yang telah diterjemahkan "
"dan mesej yang sedang menunggu semakan."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Tandakan terjemahan mesin sebagai kabur supaya ia boleh disemak sebelum "
"digunakan (entri kabur tidak dikompilasi secara lalai)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "Bahasa yang digunakan untuk menulis mesej."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "Perkhidmatan terjemahan untuk digunakan dan bukannya {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Tunjukkan bar kemajuan (memerlukan pakej tqdm). Secara lalai ia ditunjukkan "
"jika tqdm dipasang dan outputnya ialah terminal."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "Terjemahan dilumpuhkan. Tetapkan {setting} dalam tetapan anda."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} memerlukan pakej {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Tiada direktori penempatan untuk diterjemahkan. Gunakan {path} atau {app}, "
"atau tetapkan {setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Jumlah"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "mesej"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "Direktori lokasi {directory} tidak wujud."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "Melangkau {locale}: tidak dipilih dengan {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Melangkau {file}: {service} tidak menyokong {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Menterjemah {file} ke dalam {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} mengembalikan bilangan terjemahan yang salah: dijangka {sent}, "
"diterima {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Terjemahan {source} dibuang kerana ruang letak atau penandanya telah "
"berubah: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Subkelas bagi {base} mesti melaksanakan {function}()."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} memerlukan pilihan {option} . Tambahkannya pada OPTIONS dalam "
"{setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr "{service} memerlukan pakej {package} . Pasangkannya dengan: {command}"
