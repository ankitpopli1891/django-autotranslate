#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} импорттоо жолу же BACKEND импорттоо жолу жана кошумча OPTIONS "
"сөздүгү бар сөздүк болушу керек."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "Котормо кызматын {service} ({source}) импорттоо мүмкүн болгон жок."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Котормо кызматын {service} импорттоо мүмкүн болгон жок."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr "{service} ({source}) котормо кызматы {base} дин субклассы эмес."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "{service} котормо кызматы {base} классынын бир бөлүгү эмес."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Котормо кызматы {service} үчүн жараксыз параметрлер: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"{makemessages} тарабынан түзүлгөн билдирүү (.po) файлдарын машина менен "
"которот. Жаңы жана өзгөртүлгөн билдирүүлөр гана которулат. {path} жана {app} "
"менен берилген жергиликтүү каталогдорду, же эгер экөө тең көрсөтүлбөсө "
"{locale_paths} ичиндегилерди которот."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr "Которула турган жергиликтүү каталог (бир нече жолу берилиши мүмкүн)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Билдирүүлөрүн которууга боло турган колдонмо (бир нече жолу берилиши мүмкүн)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Ушул тилди гана которуңуз, мисалы, pt_BR же pt-br (бир нече жолу берилиши "
"мүмкүн). Демейки шартта табылган ар бир тил которулат."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Которулган билдирүүлөрдү жана карап чыгууну күтүп жаткан билдирүүлөрдү кошо "
"алганда, бардык билдирүүлөрдү кайра которуңуз."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Машиналык котормолорду колдонуудан мурун карап чыгуу үчүн аларды бүдөмүк деп "
"белгилеңиз (бүдөмүк жазуулар демейки шартта компиляцияланбайт)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "Билдирүүлөр кайсы тилде жазылган."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "{setting} ордуна колдонула турган котормо кызматы."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Иштин жүрүшүн көрсөтүүчү тилкени көрсөтүү (tqdm пакети талап кылынат). "
"Демейки шартта, эгерде tqdm орнотулган болсо жана чыгаруу терминал болсо, ал "
"көрсөтүлөт."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "Котормо өчүрүлгөн. Жөндөөлөрүңүздөн {setting} коюңуз."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} үчүн {package} пакети талап кылынат."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Которула турган жергиликтүү каталогдор жок. {path} же {app} колдонуңуз, же "
"болбосо {setting} коюңуз."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Жалпы сумма"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "билдирүүлөр"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "{directory} жергиликтүү каталогу жок."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "{locale} өткөрүп жиберүү: {option} менен тандалган эмес."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "{file} өткөрүп жиберүү: {service} {language} колдобойт."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "{file} тилин {target_language} тилине которуу"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} туура эмес сандагы котормолорду кайтарды: күтүлгөн {sent}, алынган "
"{received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"{source} котормосу алынып салынды, анткени анын орун толтургучтары же "
"белгилери өзгөргөн: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "{base} субкласстары {function}() ишке ашырышы керек."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} үчүн {option} опциясы талап кылынат. Аны {setting} бөлүмүндөгү "
"OPTIONS бөлүмүнө кошуңуз."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr ""
"{service} үчүн {package} пакети талап кылынат. Аны төмөнкү менен орнотуңуз: "
"{command}"
