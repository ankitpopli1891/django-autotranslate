#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} import ýoly ýa-da ARKALY import ýoly we goşmaça OPTIONS sözlügi "
"bolan sözlük bolmaly."

#: config.py:77
