#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} debe ser unha ruta de importación ou un dicionario cunha ruta de "
"importación BACKEND e un dicionario OPTIONS opcional."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "Non se puido importar o servizo de tradución {service} ({source})."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Non se puido importar o servizo de tradución {service}."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"O servizo de tradución {service} ({source}) non é unha subclase de {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "O servizo de tradución {service} non é unha subclase de {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Opcións non válidas para o servizo de tradución {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Traduce automaticamente os ficheiros de mensaxes (.po) creados por "
"{makemessages}. Só se traducen as mensaxes novas e modificadas. Traduce os "
"directorios de configuración rexional indicados con {path} e {app}, ou os de "
"{locale_paths} se non se indica ningún."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Un directorio de configuración rexional para traducir (pódese indicar máis "
"dunha vez)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Unha aplicación cuxas mensaxes para traducir (pódense dar máis dunha vez)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Traduza só esta configuración rexional, por exemplo pt_BR ou pt-br (pódese "
"indicar máis dunha vez). Por defecto, tradúcese cada configuración rexional "
"atopada."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Traduce todas as mensaxes de novo, incluídas as mensaxes traducidas e as "
"mensaxes pendentes de revisión."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Marca as traducións automáticas como imprecisas para que se poidan revisar "
"antes do seu uso (as entradas imprecisas non se compilan por defecto)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "A lingua na que están escritas as mensaxes."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "O servizo de tradución que se vai usar en lugar de {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Mostrar unha barra de progreso (require o paquete tqdm). Por defecto, "
"móstrase se tqdm está instalado e a saída é un terminal."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "A tradución está desactivada. Define {setting} na túa configuración."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} require o paquete {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Non hai directorios de configuración rexional para traducir. Usa {path} ou "
"{app} ou define {setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Total"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "mensaxes"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "O directorio de configuración rexional {directory} non existe."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "Omitindo {locale}: non seleccionado con {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Omitindo {file}: {service} non admite {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Traducindo {file} a {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} devolveu o número incorrecto de traducións: esperado {sent}, "
"recibido {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Descartouse a tradución de {source} porque os seus marcadores de posición ou "
"o código cambiaron: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "As subclases de {base} deben implementar {function}()."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr "{service} require a opción {option} . Engádea a OPCIÓNS en {setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr "{service} require o paquete {package} . Instálao con: {command}"
