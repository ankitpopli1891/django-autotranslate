#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} ha de ser una ruta d'importació o un diccionari amb una ruta "
"d'importació BACKEND i un diccionari OPTIONS opcional."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "No s'ha pogut importar el servei de traducció {service} ({source})."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "No s'ha pogut importar el servei de traducció {service}."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"El servei de traducció {service} ({source}) no és una subclasse de {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "El servei de traducció {service} no és una subclasse de {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Opcions no vàlides per al servei de traducció {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Tradueix automàticament els fitxers de missatges (.po) creats per "
"{makemessages}. Només es tradueixen els missatges nous i els modificats. "
"Tradueix els directoris de configuració regional proporcionats amb {path} i "
"{app}, o els de {locale_paths} si no se'n proporciona cap."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Un directori de localització per traduir (es pot donar més d'una vegada)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Una aplicació que vol traduir els missatges (es poden donar més d'una "
"vegada)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Només cal traduir aquesta configuració regional, p. ex. pt_BR o pt-br (es "
"pot indicar més d'una vegada). Per defecte, es tradueixen totes les "
"configuracions regionals trobades."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Torna a traduir tots els missatges, inclosos els missatges traduïts i els "
"missatges pendents de revisió."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Marca les traduccions automàtiques com a imprecises per tal que es puguin "
"revisar abans del seu ús (les entrades imprecises no es compilen per "
"defecte)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "L'idioma en què estan escrits els missatges."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "El servei de traducció que s'ha d'utilitzar en lloc de {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Mostra una barra de progrés (requereix el paquet tqdm). Per defecte es "
"mostra si tqdm està instal·lat i la sortida és un terminal."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "La traducció està desactivada. Defineix {setting} a la configuració."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} requereix el paquet {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"No hi ha directoris de configuració regional per traduir. Feu servir {path} "
"o {app}, o bé definiu {setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Total"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "missatges"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "El directori de configuració regional {directory} no existeix."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "S'està ometent {locale}: no s'ha seleccionat amb {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "S'està ometent {file}: {service} no admet {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Traduint {file} a {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} ha retornat un nombre incorrecte de traduccions: s'esperava "
"{sent}, s'ha rebut {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"S'ha descartat la traducció de {source} perquè els seus marcadors de posició "
"o el marcatge han canviat: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Les subclasses de {base} han d'implementar {function}()."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} requereix l'opció {option} . Afegeix-la a OPTIONS a {setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr "{service} requereix el paquet {package} . Instal·leu-lo amb: {command}"
