#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} moet een importpad zijn of een woordenboek met een BACKEND-"
"importpad en een optioneel OPTIONS-woordenboek."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr ""
"Het is niet gelukt om de vertaalservice {service} ({source}) te importeren."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Het is niet gelukt om de vertaalservice {service} te importeren."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr "De vertaalservice {service} ({source}) is geen subklasse van {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "De vertaalservice {service} is geen subklasse van {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Ongeldige opties voor de vertaalservice {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Vertaal de berichtbestanden (.po) die door {makemessages} zijn gemaakt, "
"machinaal. Alleen nieuwe en gewijzigde berichten worden vertaald. Vertaalt "
"de landinstellingen in de mappen die zijn opgegeven met {path} en {app}, of "
"die in {locale_paths} als geen van beide is opgegeven."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr "Een landmap om te vertalen (kan meerdere keren worden opgegeven)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Een app waarvan de te vertalen berichten meerdere keren kunnen worden "
"ingevoerd."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Vertaal alleen deze landinstelling, bijvoorbeeld pt_BR of pt-br (kan "
"meerdere keren worden opgegeven). Standaard worden alle gevonden "
"landinstellingen vertaald."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Vertaal alle berichten opnieuw, inclusief de al vertaalde berichten en de "
"berichten die nog ter beoordeling liggen."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Markeer machinevertalingen als 'fuzzy' zodat ze vóór gebruik kunnen worden "
"gecontroleerd (fuzzy-vermeldingen worden standaard niet gecompileerd)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "De taal waarin de berichten zijn geschreven."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "De vertaalservice die in plaats van {setting} gebruikt moet worden."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Toon een voortgangsbalk (vereist het tqdm-pakket). Standaard wordt deze "
"weergegeven als tqdm is geïnstalleerd en de uitvoer een terminal is."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "Vertaling is uitgeschakeld. Stel {setting} in uw instellingen in."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} vereist het pakket {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Geen lokale mappen om te vertalen. Gebruik {path} of {app}, of stel "
"{setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Totaal"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "berichten"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "De landinstellingenmap {directory} bestaat niet."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "{locale} wordt overgeslagen: niet geselecteerd met {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr ""
"Bestand {file} {service} wordt overgeslagen: {language} wordt niet "
"ondersteund."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Het bestand {file} vertalen naar de {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} heeft het verkeerde aantal vertalingen geretourneerd: verwacht "
"{sent}, ontvangen {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"De vertaling van {source} is verwijderd omdat de placeholders of de opmaak "
"ervan zijn gewijzigd: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Subklassen van {base} moeten {function}() implementeren."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} vereist de optie {option} . Voeg deze toe aan OPTIONS in {setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr "{service} vereist het pakket {package} . Installeer het met: {command}"
