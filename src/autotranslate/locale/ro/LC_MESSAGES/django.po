#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} trebuie să fie o cale de import sau un dicționar cu o cale de "
"import BACKEND și un dicționar OPTIONS opțional."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "Nu s-a putut importa serviciul de traducere {service} ({source})."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Nu s-a putut importa serviciul de traducere {service}."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr ""
"Serviciul de traducere {service} ({source}) nu este o subclasă a {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "Serviciul de traducere {service} nu este o subclasă a {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Opțiuni nevalide pentru serviciul de traducere {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Traduce automat fișierele de mesaje (.po) create de {makemessages}. Sunt "
"traduse doar mesajele noi și cele modificate. Traduce directoarele locale "
"specificate cu {path} și {app} sau pe cele din {locale_paths} dacă nu este "
"specificat niciunul."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Un director de locale de tradus (poate fi specificat de mai multe ori)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"O aplicație ale cărei mesaje trebuie traduse (pot fi date de mai multe ori)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Traduceți doar această setare regională, de exemplu pt_BR sau pt-br (poate "
"fi specificată de mai multe ori). În mod implicit, fiecare setare regională "
"găsită este tradusă."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Traduceți din nou toate mesajele, inclusiv mesajele traduse și mesajele care "
"așteaptă revizuire."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Marcați traducerile automate ca fiind imprecise pentru a putea fi revizuite "
"înainte de utilizare (intrările imprecise nu sunt compilate în mod implicit)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "Limba în care sunt scrise mesajele."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "Serviciul de traducere de utilizat în loc de {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Afișează o bară de progres (necesită pachetul tqdm). În mod implicit, este "
"afișată dacă tqdm este instalat și ieșirea este un terminal."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "Traducerea este dezactivată. Setați {setting} în setări."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} necesită pachetul {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Nu există directoare de setări regionale de tradus. Folosiți {path} sau "
"{app} sau setați {setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Total"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "mesaje"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "Directorul de setări regionale {directory} nu există."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "Se omite {locale}: neselectat cu {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Se omite {file}: {service} nu este compatibil cu {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Traducerea {file} în {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} a returnat un număr greșit de traduceri: așteptat {sent}, primit "
"{received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Traducerea lui {source} a fost eliminată deoarece provizoriile sau markup-ul "
"acesteia s-au modificat: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Subclasele lui {base} trebuie să implementeze {function}()."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} necesită opțiunea {option} . Adăugați-o la OPTIONS în {setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr "{service} necesită pachetul {package} . Instalați-l cu: {command}"
