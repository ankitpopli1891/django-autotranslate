#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} musi być ścieżką importu lub słownikiem ze ścieżką importu BACKEND "
"i opcjonalnym słownikiem OPTIONS."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "Nie można zaimportować usługi tłumaczeniowej {service} ({source})."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Nie można zaimportować usługi tłumaczeniowej {service}."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr "Usługa tłumaczeniowa {service} ({source}) nie jest podklasą {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "Usługa tłumaczeniowa {service} nie jest podklasą {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Nieprawidłowe opcje dla usługi tłumaczeniowej {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Automatycznie tłumaczy pliki wiadomości (.po) utworzone przez "
"{makemessages}. Tłumaczone są tylko nowe i zmienione wiadomości. Tłumaczone "
"są katalogi ustawień regionalnych podane w {path} i {app} lub te w "
"{locale_paths} , jeśli żaden z nich nie został podany."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr ""
"Katalog ustawień regionalnych do przetłumaczenia (można podać więcej niż "
"raz)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Aplikacja, której wiadomości należy przetłumaczyć (można podać więcej niż "
"raz)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Tłumacz tylko tę lokalizację, np. pt_BR lub pt-br (można podać więcej niż "
"raz). Domyślnie każda znaleziona lokalizacja jest tłumaczona."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Przetłumacz ponownie wszystkie wiadomości, w tym wiadomości przetłumaczone i "
"oczekujące na recenzję."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Oznacz tłumaczenia maszynowe jako nieprecyzyjne, aby można je było przejrzeć "
"przed użyciem (domyślnie nieprecyzyjne wpisy nie są kompilowane)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "Język, w którym napisane są wiadomości."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "Usługa tłumaczeniowa, która ma być używana zamiast {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Wyświetl pasek postępu (wymaga pakietu tqdm). Domyślnie jest on wyświetlany, "
"jeśli tqdm jest zainstalowany, a wyjściem jest terminal."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "Tłumaczenie jest wyłączone. Ustaw {setting} w swoich ustawieniach."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} wymaga pakietu {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Brak katalogów ustawień regionalnych do przetłumaczenia. Użyj {path} lub "
"{app} albo ustaw {setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Całkowity"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "wiadomości"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "Katalog ustawień regionalnych {directory} nie istnieje."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "Pomijanie {locale}: nie wybrano za pomocą {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Pomijanie pliku {file}: {service} nie obsługuje {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Tłumaczenie pliku {file} na {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} zwrócił nieprawidłową liczbę tłumaczeń: oczekiwano {sent}, "
"odebrano {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Odrzucono tłumaczenie {source} , ponieważ jego symbole zastępcze lub "
"znaczniki uległy zmianie: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Podklasy {base} muszą implementować {function}()."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr "{service} wymaga opcji {option} . Dodaj ją do OPCJI w {setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr ""
"{service} wymaga pakietu {package} . Zainstaluj go za pomocą: {command}"
