#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} должен быть путем импорта или словарем, содержащим путь импорта "
"BACKEND и необязательный словарь OPTIONS."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "Не удалось импортировать службу перевода {service} ({source})."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "Не удалось импортировать службу перевода {service}."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr "Сервис перевода {service} ({source}) не является подклассом {base}."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "Сервис перевода {service} не является подклассом {base}."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "Недопустимые параметры для службы перевода {service}: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"Машинный перевод файлов сообщений (.po), созданных с помощью {makemessages}. "
"Переводятся только новые и измененные сообщения. Переводит каталоги "
"локализации, указанные с помощью {path} и {app}, или каталоги в "
"{locale_paths} , если ни один из них не указан."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr "Каталог локализации для перевода (можно указать несколько раз)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr ""
"Приложение, сообщения которого нужно перевести (можно указывать несколько "
"раз)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"Переводить следует только для этой локали, например, pt_BR или pt-br (можно "
"указать несколько раз). По умолчанию переводятся все найденные локали."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"Переведите все сообщения заново, включая переведенные сообщения и сообщения, "
"ожидающие проверки."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"Помечайте машинные переводы как нечеткие, чтобы их можно было проверить "
"перед использованием (нечеткие записи по умолчанию не компилируются)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "Язык, на котором написаны сообщения."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "Сервис перевода, который следует использовать вместо {setting}."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"Отображение индикатора выполнения (требуется пакет tqdm). По умолчанию он "
"отображается, если пакет tqdm установлен и вывод осуществляется через "
"терминал."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "Перевод отключен. Установите значение {setting} в настройках."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "Для использования {option} требуется пакет {package} ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"Нет каталогов локализации для перевода. Используйте {path} или {app}, или "
"установите {setting}."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "Общий"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "сообщения"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "Каталог локали {directory} не существует."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "Пропускаем {locale}: не выбрано с {option}."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "Пропуск файла {file}: {service} не поддерживает {language}."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "Перевод файла {file} на {target_language}"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} вернул неверное количество переводов: ожидалось {sent}, получено "
"{received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"Перевод {source} был отброшен, поскольку изменились его заполнители или "
"разметка: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "Подклассы {base} должны реализовывать интерфейс {function}()."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"Для работы {service} требуется опция {option} . Добавьте её в раздел OPTIONS "
"в {setting}."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr ""
"Для работы {service} требуется пакет {package} . Установите его с помощью "
"команды: {command}"
