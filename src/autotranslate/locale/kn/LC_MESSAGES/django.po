#: config.py:36
#, python-brace-format
msgid ""
"{setting} must be an import path or a dictionary with a BACKEND import path "
"and an optional OPTIONS dictionary."
msgstr ""
"{setting} ಆಮದು ಮಾರ್ಗ ಅಥವಾ BACKEND ಆಮದು ಮಾರ್ಗ ಮತ್ತು ಐಚ್ಛಿಕ OPTIONS ನಿಘಂಟನ್ನು "
"ಹೊಂದಿರುವ ನಿಘಂಟಾಗಿರಬೇಕು."

#: config.py:77
#, python-brace-format
msgid "Could not import the translation service {service} ({source})."
msgstr "ಅನುವಾದ ಸೇವೆ {service} ({source}) ಅನ್ನು ಆಮದು ಮಾಡಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#: config.py:79
#, python-brace-format
msgid "Could not import the translation service {service}."
msgstr "ಅನುವಾದ ಸೇವೆ {service} ಅನ್ನು ಆಮದು ಮಾಡಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#: config.py:87
#, python-brace-format
msgid ""
"The translation service {service} ({source}) is not a subclass of {base}."
msgstr "ಅನುವಾದ ಸೇವೆ {service} ({source}) {base} ನ ಉಪವರ್ಗವಲ್ಲ."

#: config.py:91
#, python-brace-format
msgid "The translation service {service} is not a subclass of {base}."
msgstr "ಅನುವಾದ ಸೇವೆ {service} {base} ನ ಉಪವರ್ಗವಲ್ಲ."

#: config.py:104
#, python-brace-format
msgid "Invalid options for the translation service {service}: {error}"
msgstr "ಅನುವಾದ ಸೇವೆ {service} ಗಾಗಿ ಅಮಾನ್ಯ ಆಯ್ಕೆಗಳು: {error}"

#: management/commands/autotranslate.py:68
#, python-brace-format
msgid ""
"Machine translate the message (.po) files created by {makemessages}. Only "
"new and changed messages are translated. Translates the locale directories "
"given with {path} and {app}, or those in {locale_paths} if neither is given."
msgstr ""
"{makemessages} ರಚಿಸಿದ ಸಂದೇಶ (.po) ಫೈಲ್‌ಗಳನ್ನು ಯಂತ್ರ ಅನುವಾದಿಸುತ್ತದೆ. ಹೊಸ ಮತ್ತು "
"ಬದಲಾದ ಸಂದೇಶಗಳನ್ನು ಮಾತ್ರ ಅನುವಾದಿಸಲಾಗುತ್ತದೆ. {path} ಮತ್ತು {app} ನೊಂದಿಗೆ ನೀಡಲಾದ "
"ಲೊಕೇಲ್ ಡೈರೆಕ್ಟರಿಗಳನ್ನು ಅಥವಾ ಎರಡನ್ನೂ ನೀಡದಿದ್ದರೆ {locale_paths} ನಲ್ಲಿರುವವುಗಳನ್ನು "
"ಅನುವಾದಿಸುತ್ತದೆ."

#: management/commands/autotranslate.py:111
msgid "A locale directory to translate (can be given more than once)."
msgstr "ಅನುವಾದಿಸಲು ಒಂದು ಲೊಕೇಲ್ ಡೈರೆಕ್ಟರಿ (ಒಂದಕ್ಕಿಂತ ಹೆಚ್ಚು ಬಾರಿ ನೀಡಬಹುದು)."

#: management/commands/autotranslate.py:124
msgid "An app whose messages to translate (can be given more than once)."
msgstr "ಸಂದೇಶಗಳನ್ನು ಅನುವಾದಿಸಬೇಕಾದ ಅಪ್ಲಿಕೇಶನ್ (ಒಂದಕ್ಕಿಂತ ಹೆಚ್ಚು ಬಾರಿ ನೀಡಬಹುದು)."

#: management/commands/autotranslate.py:139
msgid ""
"Only translate this locale, e.g. pt_BR or pt-br (can be given more than "
"once). By default every locale found is translated."
msgstr ""
"ಈ ಸ್ಥಳವನ್ನು ಮಾತ್ರ ಅನುವಾದಿಸಿ, ಉದಾ. pt_BR ಅಥವಾ pt-br (ಒಂದಕ್ಕಿಂತ ಹೆಚ್ಚು ಬಾರಿ "
"ನೀಡಬಹುದು). ಪೂರ್ವನಿಯೋಜಿತವಾಗಿ ಕಂಡುಬರುವ ಪ್ರತಿಯೊಂದು ಸ್ಥಳವನ್ನು ಅನುವಾದಿಸಲಾಗುತ್ತದೆ."

#: management/commands/autotranslate.py:154
msgid ""
"Translate all messages again, including translated messages and messages "
"awaiting review."
msgstr ""
"ಅನುವಾದಿತ ಸಂದೇಶಗಳು ಮತ್ತು ವಿಮರ್ಶೆಗಾಗಿ ಕಾಯುತ್ತಿರುವ ಸಂದೇಶಗಳು ಸೇರಿದಂತೆ ಎಲ್ಲಾ "
"ಸಂದೇಶಗಳನ್ನು ಮತ್ತೆ ಅನುವಾದಿಸಿ."

#: management/commands/autotranslate.py:168
msgid ""
"Mark machine translations as fuzzy so they can be reviewed before use (fuzzy "
"entries are not compiled by default)."
msgstr ""
"ಯಂತ್ರ ಅನುವಾದಗಳನ್ನು ಅಸ್ಪಷ್ಟ ಎಂದು ಗುರುತಿಸಿ ಇದರಿಂದ ಅವುಗಳನ್ನು ಬಳಸುವ ಮೊದಲು "
"ಪರಿಶೀಲಿಸಬಹುದು (ಅಸ್ಪಷ್ಟ ನಮೂದುಗಳನ್ನು ಪೂರ್ವನಿಯೋಜಿತವಾಗಿ ಸಂಕಲಿಸಲಾಗುವುದಿಲ್ಲ)."

#: management/commands/autotranslate.py:179
msgid "The language the messages are written in."
msgstr "ಸಂದೇಶಗಳನ್ನು ಯಾವ ಭಾಷೆಯಲ್ಲಿ ಬರೆಯಲಾಗಿದೆ."

#: management/commands/autotranslate.py:190
#, python-brace-format
msgid "The translation service to use instead of {setting}."
msgstr "{setting} ಬದಲಿಗೆ ಬಳಸಬೇಕಾದ ಅನುವಾದ ಸೇವೆ."

#: management/commands/autotranslate.py:204
msgid ""
"Show a progress bar (requires the tqdm package). By default it is shown if "
"tqdm is installed and the output is a terminal."
msgstr ""
"ಪ್ರಗತಿ ಪಟ್ಟಿಯನ್ನು ತೋರಿಸಿ (tqdm ಪ್ಯಾಕೇಜ್ ಅಗತ್ಯವಿದೆ). tqdm ಅನ್ನು ಸ್ಥಾಪಿಸಿದ್ದರೆ ಮತ್ತು "
"ಔಟ್‌ಪುಟ್ ಟರ್ಮಿನಲ್ ಆಗಿದ್ದರೆ ಪೂರ್ವನಿಯೋಜಿತವಾಗಿ ಅದನ್ನು ತೋರಿಸಲಾಗುತ್ತದೆ."

#: management/commands/autotranslate.py:214
#, python-brace-format
msgid "Translation is disabled. Set {setting} in your settings."
msgstr "ಅನುವಾದವನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ {setting} ಹೊಂದಿಸಿ."

#: management/commands/autotranslate.py:223
#, python-brace-format
msgid "{option} requires the {package} package."
msgstr "{option} ಗೆ {package} ಪ್ಯಾಕೇಜ್ ಅಗತ್ಯವಿದೆ."

#: management/commands/autotranslate.py:248
#, python-brace-format
msgid ""
"No locale directories to translate. Use {path} or {app}, or set {setting}."
msgstr ""
"ಅನುವಾದಿಸಲು ಯಾವುದೇ ಸ್ಥಳೀಯ ಡೈರೆಕ್ಟರಿಗಳಿಲ್ಲ. {path} ಅಥವಾ {app} ಬಳಸಿ, ಅಥವಾ "
"{setting} ಹೊಂದಿಸಿ."

#: management/commands/autotranslate.py:290
msgctxt "progress bar"
msgid "Total"
msgstr "ಒಟ್ಟು"

#: management/commands/autotranslate.py:291
#: management/commands/autotranslate.py:318
msgctxt "progress bar"
msgid "messages"
msgstr "ಸಂದೇಶಗಳು"

#: management/commands/autotranslate.py:350
#, python-brace-format
msgid "The locale directory {directory} does not exist."
msgstr "ಸ್ಥಳೀಯ ಡೈರೆಕ್ಟರಿ {directory} ಅಸ್ತಿತ್ವದಲ್ಲಿಲ್ಲ."

#: management/commands/autotranslate.py:375
#, python-brace-format
msgid "Skipping {locale}: not selected with {option}."
msgstr "{locale} ಅನ್ನು ಬಿಟ್ಟುಬಿಡಲಾಗುತ್ತಿದೆ: {option} ನೊಂದಿಗೆ ಆಯ್ಕೆ ಮಾಡಲಾಗಿಲ್ಲ."

#: management/commands/autotranslate.py:387
#, python-brace-format
msgid "Skipping {file}: {service} does not support {language}."
msgstr "{file} ಬಿಟ್ಟುಬಿಡಲಾಗುತ್ತಿದೆ: {service} {language} ಬೆಂಬಲಿಸುವುದಿಲ್ಲ."

#: management/commands/autotranslate.py:411
#, python-brace-format
msgid "Translating {file} into {target_language}"
msgstr "{file} ಅನ್ನು {target_language} ಗೆ ಅನುವಾದಿಸಲಾಗುತ್ತಿದೆ"

#: management/commands/autotranslate.py:514
#, python-brace-format
msgid ""
"{service} returned the wrong number of translations: expected {sent}, "
"received {received}."
msgstr ""
"{service} ಅನುವಾದಗಳ ತಪ್ಪಾದ ಸಂಖ್ಯೆಯನ್ನು ಹಿಂತಿರುಗಿಸಿದೆ: ನಿರೀಕ್ಷಿಸಲಾಗಿದೆ {sent}, "
"ಸ್ವೀಕರಿಸಲಾಗಿದೆ {received}."

#: management/commands/autotranslate.py:591
#, python-brace-format
msgid ""
"Discarded the translation of {source} because its placeholders or markup "
"changed: {translation}"
msgstr ""
"{source} ನ ಅನುವಾದವನ್ನು ತಿರಸ್ಕರಿಸಲಾಗಿದೆ ಏಕೆಂದರೆ ಅದರ ಪ್ಲೇಸ್‌ಹೋಲ್ಡರ್‌ಗಳು ಅಥವಾ ಮಾರ್ಕ್ಅಪ್ "
"ಬದಲಾಗಿದೆ: {translation}"

#: services.py:145 services.py:163
#, python-brace-format
msgid "Subclasses of {base} must implement {function}()."
msgstr "{base} ನ ಉಪವರ್ಗಗಳು {function}() ಅನ್ನು ಕಾರ್ಯಗತಗೊಳಿಸಬೇಕು."

#: services.py:394
#, python-brace-format
msgid "{service} requires the {option} option. Add it to OPTIONS in {setting}."
msgstr ""
"{service} ಗೆ {option} ಆಯ್ಕೆಯ ಅಗತ್ಯವಿದೆ. ಅದನ್ನು {setting} ನಲ್ಲಿ OPTIONS ಗೆ ಸೇರಿಸಿ."

#: services.py:407 services.py:502
#, python-brace-format
msgid "{service} requires the {package} package. Install it with: {command}"
msgstr ""
"{service} ಗೆ {package} ಪ್ಯಾಕೇಜ್ ಅಗತ್ಯವಿದೆ. ಇದನ್ನು ಇದರೊಂದಿಗೆ ಸ್ಥಾಪಿಸಿ: {command}"
